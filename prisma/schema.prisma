generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                   @id @default(cuid())
  clerkId             String?                  @unique
  name                String
  email               String                   @unique
  password            String?
  phone               String?
  parentPhone         String?
  age                 Int?
  educationalStage    String?
  role                String                   @default("student")
  isActive            Boolean                  @default(true)
  isDeleted           Boolean                  @default(false)
  deletedAt           DateTime?
  // Owner superadmin (Ahmed): may manage the other superadmins. Only one is true.
  isOwner             Boolean                  @default(false)
  // Demo/seed account generated by the owner's virtual-data tool — safe to purge.
  isVirtual           Boolean                  @default(false)
  profileCompleted    Boolean                  @default(false)
  lastLoginAt         DateTime?
  points              Int                      @default(0)
  pointsUpdatedAt     DateTime                 @default(now())
  loginStreak         Int                      @default(0)
  lastLoginDate       DateTime?
  streakFreezes       Int                      @default(0)
  referralCode        String?                  @unique
  referredById        String?
  balance             Float                    @default(0)
  isVerified          Boolean                  @default(false)
  verificationStatus  String                   @default("UNVERIFIED") // "VERIFIED" | "WAITING_FOR_OTP" | "UNVERIFIED"
  // Credential-stuffing guard. Enforces the existing `max_login_attempts` /
  // `lockout_minutes` platform config, which previously had no effect.
  failedLoginAttempts Int                      @default(0)
  lockedUntil         DateTime?
  // Session revocation version: incrementing this invalidates all previously issued JWTs.
  tokenVersion        Int                      @default(0)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  parentToken         ParentToken?
  otpQueueItems       OtpQueueItem[]
  referralsSent       Referral[]               @relation("ReferralsSent")
  referralReceived    Referral?                @relation("ReferralReceived")
  aiConversations     AIConversation[]         @relation("StudentAIConversations")
  aiInsights          AIStudentInsight[]       @relation("StudentAIInsights")
  accessCodes         AccessCode[]             @relation("StudentCodes")
  courses             Course[]                 @relation("TeacherCourses")
  teacherProfile      TeacherProfile?
  devices             Device[]
  dailyExamResults    DailyExamResult[]
  studyPlans          DailyStudyPlan[]         @relation("StudentStudyPlans")
  gradeRequests       GradeAdjustmentRequest[] @relation("StudentGradeRequests")
  reviewedGradeReqs   GradeAdjustmentRequest[] @relation("TeacherGradeRequests")
  viewRequests        VideoViewRequest[]       @relation("StudentViewRequests")
  reviewedViewReqs    VideoViewRequest[]       @relation("TeacherViewRequests")
  progress            Progress[]
  quizResults         QuizResult[]
  feedbacks           StudentFeedback[]        @relation("StudentFeedbacks")
  receivedFeedbacks   StudentFeedback[]        @relation("TeacherFeedbacks")
  assignedTickets     SupportTicket[]          @relation("AssignedTickets")
  supportTickets      SupportTicket[]          @relation("StudentTickets")
  notifications       Notification[]
  balanceTransactions BalanceTransaction[]
  homeworkSubmissions HomeworkSubmission[]
  teacherHomeworks    Homework[]               @relation("TeacherHomework")
  iqData              String? // JSON blob: IQData from iq-system.ts
  overallIQ           Int                      @default(1000)
  folderPurchases     FolderPurchase[]
  videoPurchases      VideoPurchase[]
  watchSessions       VideoWatchSession[]
  securityViolations  SecurityViolation[]
  videoQuestionResponses VideoQuestionResponse[]

  // ── Plans (الخطط الدراسية) System Reverse Relations ──
  planEnrollments         PlanEnrollment[]
  planProjectSubmissions  PlanProjectSubmission[]
  planHomeworkSubmissions PlanHomeworkSubmission[]
  planAiChatMessages      PlanAIChatMessage[]

  // ── Teacher Promo / Referral Program ──
  promoProgramEnabled     Boolean                  @default(false)
  promoCode               String?                  @unique
  promoCodeCreatedAt      DateTime?
  referredByTeacherId     String?
  referredByTeacher       User?                    @relation("TeacherStudentReferrals", fields: [referredByTeacherId], references: [id], onDelete: SetNull)
  referredStudents        User[]                   @relation("TeacherStudentReferrals")
  teacherAttributions     TeacherReferralAttribution[] @relation("TeacherAttributions")
  studentAttributions     TeacherReferralAttribution[] @relation("StudentAttributions")
  teacherSubscriptions    TeacherSubscription[]        @relation("TeacherSubscriptions")
  studentSubscriptions    TeacherSubscription[]        @relation("StudentSubscriptions")
  discountCodesCreated    DiscountCode[]               @relation("DiscountCodeCreator")
  discountCodeUsages      DiscountCodeUsage[]          @relation("DiscountCodeUser")

  parentVerified           Boolean                      @default(false)
  parentVerifiedAt         DateTime?
  parentVerificationStatus String                       @default("PENDING")
  parentVerificationEvents ParentVerificationEvent[]

  isDemo                   Boolean                      @default(false)

  accountMode              String                       @default("NORMAL") // "NORMAL" | "TESTER"
  testerCapabilities       String?                      // JSON string of boolean capability flags
  testerNotes              String?                      // Internal notes by superadmin
  testerActivityLogs       TesterActivityLog[]
  courseEnrollments        CourseEnrollment[]
  contentProgress          StudentContentProgress[]

  @@index([role])
  @@index([educationalStage])
  @@index([email])
  @@index([isDeleted])
  @@index([promoCode])
  @@index([isDemo])
  @@index([accountMode])
}

model Course {
  id                  String                   @id @default(cuid())
  title               String
  // SEO-friendly English URL slug, e.g. "math-secondary-3-ab12cd". Nullable so
  // existing rows keep working (resolved by id-or-slug); backfilled by script.
  slug                String?                  @unique
  subject             String
  description         String?
  thumbnailUrl        String?
  educationalStage    String
  teacherId           String
  isPaid              Boolean                  @default(false)
  price               Float?
  discountPercent     Float?
  discountExpiresAt   DateTime?
  contactPhone        String?
  maxWatchCount       Int                      @default(3)
  sequentialAccess    Boolean                  @default(true)
  enableWatchedButton Boolean                  @default(false)
  homeworkUrl         String?
  allowDirectInstall  Boolean                  @default(false)
  // Demo course generated by the owner's virtual-data tool — safe to purge.
  isVirtual           Boolean                  @default(false)
  // Course delivery mode: "ONLINE" (default online platform) | "CENTER" (center.code-up.tech) | "BOTH"
  deliveryMode        String                   @default("ONLINE")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  accessCodes         AccessCode[]
  teacher             User                     @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  folders             Folder[]
  gradeRequests       GradeAdjustmentRequest[]
  feedbacks           StudentFeedback[]
  supportTickets      SupportTicket[]
  planCourseLinks     PlanCourseLink[]
  enrollments         CourseEnrollment[]

  @@index([teacherId])
  @@index([educationalStage])
  @@index([deliveryMode])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Superadmin-editable platform constants (JWT expiry, watch rules, limits, …).
/// Values are stored as strings; `type` says how to coerce them.
model PlatformConfig {
  key       String   @id
  value     String
  type      String // number | string | boolean
  category  String
  label     String
  updatedAt DateTime @default(now()) @updatedAt
}

/// A configurable AI provider for study-plan generation. `apiKeyEnc` is an
/// AES-256-GCM ciphertext (CONFIG_ENCRYPTION_KEY) and is NEVER returned to the
/// client — the API exposes only a `hasKey` boolean.
model AIProvider {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  baseUrl   String
  models    String // JSON array of model id strings
  apiKeyEnc String? // AES-256-GCM, never returned to the client
  isPrimary Boolean  @default(false)
  isBackup  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A superadmin-initiated bulk account wipe. Scheduled requests wait `executeAt`
/// (default +7 days) before the targeted accounts are soft-deleted; `instant`
/// requests run immediately (gated by BULK_DELETE_PASSWORD). Soft-deleted users
/// land in the existing trash and are purged permanently 30 days later.
model BulkDeletionRequest {
  id              String    @id @default(cuid())
  scope           String // "all" (students+teachers) | "students" | "teachers"
  status          String    @default("pending") // pending | executed | cancelled
  instant         Boolean   @default(false)
  requestedById   String
  requestedByName String
  requestedAt     DateTime  @default(now())
  executeAt       DateTime // when the soft-delete runs
  executedAt      DateTime?
  cancelledAt     DateTime?
  affectedCount   Int?
  createdAt       DateTime  @default(now())

  @@index([status, executeAt])
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String // matches the persistent `device_id` cookie
  label      String?
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model TeacherProfile {
  id        String @id @default(cuid())
  teacherId String @unique
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  slug        String  @unique // "MR-KHALED" → /MR-KHALED
  displayName String?
  bio         String?
  photoUrl    String?
  bannerUrl   String?

  navColor    String? @default("#0b0f19")
  accentColor String? @default("#6366f1")

  socials String? // JSON: { facebook, youtube, tiktok }

  featuredCourseId String?
  isPublished      Boolean @default(false)

  /// "احجز الان" subscription plan prices (default 180, 750, 1200)
  priceMonthly      Float? @default(180)
  priceTermly       Float? @default(750)
  priceYearly       Float? @default(1200)

  /// Per-plan discount percentages (0-100)
  discountMonthly   Float?
  discountTermly    Float?
  discountYearly    Float?

  /// Per-grade specific pricing overrides (JSON: { sec_1: {...}, sec_2: {...} })
  stagePricing      String?

  /// First course start date — shown under "احجز الان" button
  courseStartDate   DateTime?

  /// Optional teacher contact/payment link (WhatsApp, payment page, etc.)
  bookingContactUrl String?

  /// Toggle to enable or disable English/Languages track booking for this teacher
  enableLanguagesTrack Boolean @default(true)

  /// Extra surcharge for English / Languages track per subscription duration (default: 0 EGP)
  priceLanguagesMonthly Float? @default(0)
  priceLanguagesTermly  Float? @default(0)
  priceLanguagesYearly  Float? @default(0)

  /// Custom payment instructions or Vodafone Cash number
  paymentNotes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Folder {
  id                 String           @id @default(cuid())
  name               String
  order              Int              @default(0)
  courseId           String
  color              String?          @default("blue")
  // Scheduled unlock: null = available now; a future date locks the whole folder
  // (and all its videos) until then. Honored in every student content read path.
  publishAt          DateTime?
  /// Per-folder price for monthly subscription purchases (0 = free with course enrolment).
  price              Float?           @default(0)
  /// When false the teacher blocks wholesale folder purchase — only individual video purchase allowed.
  isPurchasable      Boolean          @default(true)
  /// Per-folder homework URL (old-style external link, kept for compat).
  homeworkUrl        String?
  monthIndex         Int?
  monthIndexIsManual Boolean          @default(false)
  createdAt          DateTime         @default(now())
  course             Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materials          Material[]
  quizzes            Quiz[]
  videos             Video[]
  homeworks          Homework[]
  folderPurchases    FolderPurchase[]
  accessCodes        AccessCode[]

  @@index([courseId])
}

model Video {
  id                  String                 @id @default(cuid())
  title               String
  // Legacy field — kept for existing rows; new rows use videoProvider + providerVideoId
  vdoCipherId         String                 @default("")
  videoProvider       String                 @default("vdocipher") // vdocipher | bunny | youtube
  providerVideoId     String                 @default("")
  durationMinutes     Int                    @default(0)
  maxWatchesPerUser   Int                    @default(3)
  isFree              Boolean                @default(false)
  // Scheduled unlock: null = available now; a future date locks this video until
  // then. Effective unlock = the later of this and the folder's publishAt.
  publishAt           DateTime?
  order               Int                    @default(0)
  folderId            String
  /// Individual lesson purchase price (0 = not individually purchasable unless set).
  price               Float?                 @default(0)
  lessonIndexInMonth  Int?
  lessonIndexIsManual Boolean                @default(false)
  createdAt           DateTime               @default(now())
  progress            Progress[]
  folder              Folder                 @relation(fields: [folderId], references: [id], onDelete: Cascade)
  watchSessions       VideoWatchSession[]
  questions           VideoQuestion[]
  videoPurchases      VideoPurchase[]
  accessCodes         AccessCode[]
  homeworks           Homework[]
  planSources         PlanLessonSource[]
  unmatchedPlans      UnmatchedPlanContent[]
  viewRequests        VideoViewRequest[]
  vdoCipherAssets     VdoCipherVideoAsset[]

  @@index([folderId])
}

/// A student asking for extra views after exhausting Video.maxWatchesPerUser.
/// Grants are per student and per video: the quota check adds up grantedViews
/// from approved rows, so approving one student never widens the limit for
/// everyone else the way editing maxWatchesPerUser would.
model VideoViewRequest {
  id           String    @id @default(cuid())
  studentId    String
  videoId      String
  reason       String?
  /// pending | approved | rejected
  status       String    @default("pending")
  /// Extra views granted on approval. Always 0 while pending or rejected.
  grantedViews Int       @default(0)
  teacherId    String?
  teacherNotes String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      User      @relation("StudentViewRequests", fields: [studentId], references: [id], onDelete: Cascade)
  teacher      User?     @relation("TeacherViewRequests", fields: [teacherId], references: [id])
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([videoId])
  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
  @@index([studentId, videoId])
}

model VideoWatchSession {
  id            String    @id @default(cuid())
  sessionToken  String    @unique @default(cuid())
  videoId       String
  studentId     String
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?
  usedWatchSlot Boolean   @default(true)
  ipAddress     String?
  userAgent     String?
  video         Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  student       User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([studentId])
  @@index([sessionToken])
}

model Quiz {
  id                  String                   @id @default(cuid())
  title               String
  timeLimitMinutes    Int                      @default(30)
  retakeCooldownHours Int                      @default(0)
  folderId            String?
  planLessonId        String?
  createdAt           DateTime                 @default(now())
  gradeRequests       GradeAdjustmentRequest[]
  folder              Folder?                  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  planLesson          PlanLesson?              @relation(fields: [planLessonId], references: [id], onDelete: Cascade)
  questions           QuizQuestion[]
  results             QuizResult[]

  @@index([folderId])
  @@index([planLessonId])
}

model Material {
  id        String   @id @default(cuid())
  title     String
  url       String
  type      String
  order     Int      @default(0)
  folderId  String
  createdAt DateTime @default(now())
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  question      String
  questionType  String @default("mcq") // "mcq" | "essay"
  imageUrl      String? // Optional image/diagram URL attached to the question
  optionA       String @default("")
  optionB       String @default("")
  optionC       String @default("")
  optionD       String @default("")
  correctAnswer String @default("A")
  order         Int    @default(0)
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model AccessCode {
  id         String    @id @default(cuid())
  code       String    @unique
  courseId   String
  /// Scope: null = whole course (TERM), set = specific folder or video
  folderId   String?
  videoId    String?
  studentId  String?
  isActive   Boolean   @default(true)
  /// TERM = full course | FOLDER = one folder | VIDEO = one lesson
  accessType String    @default("TERM") // TERM | FOLDER | VIDEO
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  folder     Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  student    User?     @relation("StudentCodes", fields: [studentId], references: [id])

  @@index([courseId])
  @@index([folderId])
  @@index([videoId])
  @@index([studentId])
  @@index([isActive])
}

model Progress {
  id                  String    @id @default(cuid())
  studentId           String
  videoId             String
  watched             Boolean   @default(false)
  watchedAt           DateTime?
  // Resume playback: last position kept per (student, video) — NOT per watch
  // session — so it survives a 4h-slot expiry. A student cut off mid-video on
  // their last watch resumes where they stopped, not at zero.
  lastPositionSeconds Int       @default(0)
  positionUpdatedAt   DateTime?
  // Cumulative real playback time — server-side increment only (anti-cheat).
  watchedSecondsTotal Float     @default(0)
  // Recency marker for "Continue Watching" UI ordering.
  lastWatchedAt       DateTime  @default(now())
  student             User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video               Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId])
  @@index([videoId])
}

/// Content-type-agnostic node used by the server-side prerequisite graph.
/// sourceId points at the canonical row for the declared type (Video, Quiz,
/// Homework, etc.); the compound unique key prevents duplicate graph nodes.
model ContentItem {
  id              String                   @id @default(cuid())
  type            ContentType
  sourceId        String
  title           String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  prerequisites   ContentPrerequisite[]    @relation("TargetContentPrerequisites")
  requiredBy      ContentPrerequisite[]    @relation("PrerequisiteContent")
  studentProgress StudentContentProgress[]

  @@unique([type, sourceId])
  @@index([sourceId])
}

/// Directed edge: target content cannot open until prerequisite content
/// satisfies the edge's status and optional score rule.
model ContentPrerequisite {
  id                    String                @id @default(cuid())
  targetContentId       String
  prerequisiteContentId String
  requiredStatus        ContentProgressStatus @default(COMPLETED)
  minScore              Float?
  createdAt             DateTime              @default(now())
  targetContent         ContentItem            @relation("TargetContentPrerequisites", fields: [targetContentId], references: [id], onDelete: Cascade)
  prerequisiteContent   ContentItem            @relation("PrerequisiteContent", fields: [prerequisiteContentId], references: [id], onDelete: Cascade)

  @@unique([targetContentId, prerequisiteContentId])
  @@index([prerequisiteContentId])
}

/// Materialized per-student state for every graph node. Legacy video, quiz and
/// homework result tables remain supported by ContentAccessEngine during rollout.
model StudentContentProgress {
  id          String                @id @default(cuid())
  studentId   String
  contentId   String
  status      ContentProgressStatus @default(UNLOCKED)
  score       Float?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  student     User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     ContentItem           @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([studentId, contentId])
  @@index([studentId, status])
  @@index([contentId])
}

model QuizResult {
  id          String       @id @default(cuid())
  studentId   String
  quizId      String
  score       Float
  totalQ      Int
  allowRetake Boolean      @default(false)
  startedAt   DateTime?
  completedAt DateTime     @default(now())
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]

  @@unique([studentId, quizId])
  @@index([studentId])
  @@index([quizId])
}

/// Per-question answer record saved on every quiz submission.
/// Powers "view answers" modal + "wrong-questions exam" feature.
model QuizAnswer {
  id             String     @id @default(cuid())
  studentId      String
  quizId         String
  questionId     String
  resultId       String
  questionType   String     @default("mcq") // "mcq" | "essay"
  selectedAnswer String? // null = skipped for MCQ
  essayAnswer    String? // text response for Essay
  imageUrl       String? // Snapshot of question's image URL
  correctAnswer  String     @default("")
  isCorrect      Boolean    @default(false)
  status         String     @default("APPROVED") // "PENDING" | "APPROVED" | "DISAPPROVED"
  teacherReply   String?
  reviewedAt     DateTime?
  question       String // snapshot so it works even if question is later edited
  optionA        String     @default("")
  optionB        String     @default("")
  optionC        String     @default("")
  optionD        String     @default("")
  createdAt      DateTime   @default(now())
  result         QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([studentId, isCorrect])
  @@index([quizId])
  @@index([resultId])
  @@index([questionId])
  @@index([status])
}

model DailyStudyPlan {
  id            String   @id @default(cuid())
  studentId     String
  planDate      DateTime
  content       String
  status        String   @default("pending")
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())
  student       User     @relation("StudentStudyPlans", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, planDate])
  @@index([studentId])
  @@index([planDate])
}

model CourseAnalytics {
  id               String   @id @default(cuid())
  courseId         String   @unique
  totalEnrollments Int      @default(0)
  totalViews       Int      @default(0)
  averageScore     Float    @default(0)
  lastUpdatedAt    DateTime @updatedAt
  createdAt        DateTime @default(now())
}

model ClientError {
  id        String   @id @default(cuid())
  type      String
  message   String
  stack     String?
  url       String?
  userAgent String?
  userId    String?
  userRole  String?
  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  action     String
  targetType String
  targetId   String
  targetName String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([adminId])
  @@index([createdAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  studentId String
  role      String
  content   String
  context   String?
  actions   String?
  createdAt DateTime @default(now())
  student   User     @relation("StudentAIConversations", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([createdAt])
}

model StudentFeedback {
  id         String   @id @default(cuid())
  studentId  String
  courseId   String
  teacherId  String
  type       String
  rating     Int?
  content    String
  isResolved Boolean  @default(false)
  resolution String?
  aiAnalyzed Boolean  @default(false)
  aiInsights String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    User     @relation("StudentFeedbacks", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    User     @relation("TeacherFeedbacks", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([teacherId])
  @@index([type])
  @@index([createdAt])
}

model GradeAdjustmentRequest {
  id             String    @id @default(cuid())
  studentId      String
  quizId         String
  courseId       String?
  requestedBy    String
  currentScore   Float
  requestedScore Float?
  reason         String
  aiAnalysis     String?
  evidence       String?
  status         String    @default("pending")
  teacherId      String?
  teacherNotes   String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  course         Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student        User      @relation("StudentGradeRequests", fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User?     @relation("TeacherGradeRequests", fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([teacherId])
