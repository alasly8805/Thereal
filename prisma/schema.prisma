// ── In-Video Timed Questions ────────────────────────────────────────────────

/// A question anchored to a specific timestamp in a video. Teachers choose
/// between "pause" (blocks playback until answered) and "overlay" (non-blocking
/// banner, video keeps playing). The question fires only when the student's
/// playhead actually passes through triggerSecond during normal playback — not
/// on a raw seek.
model VideoQuestion {
  id              String                  @id @default(cuid())
  videoId         String
  video           Video                   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  triggerSecond   Int // e.g. 691 for 11:31
  mode            String                  @default("pause") // "pause" | "overlay"
  questionType    String                  @default("mcq") // "mcq" | "essay"
  questionText    String
  optionA         String?
  optionB         String?
  optionC         String?
  optionD         String?
  correctOption   String? // "A" | "B" | "C" | "D" (null for essay)
  explanation     String?
  refireOnRewatch Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  responses       VideoQuestionResponse[]

  @@index([videoId])
}

/// Records a student's answer to a VideoQuestion within a specific watch session.
/// The unique constraint prevents double-answering in the same session.
model VideoQuestionResponse {
  id               String        @id @default(cuid())
  videoQuestionId  String
  videoQuestion    VideoQuestion @relation(fields: [videoQuestionId], references: [id], onDelete: Cascade)
  studentId        String
  student          User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectedOption   String? // A/B/C/D for MCQ
  essayAnswer      String? // Written response text for essay questions
  isCorrect        Boolean       @default(false)
  status           String        @default("APPROVED") // "PENDING" | "APPROVED" | "DISAPPROVED"
  teacherReply     String?
  reviewedAt       DateTime?
  reviewedById     String?
  answeredAtSecond Int // actual currentTime when answered, for analytics
  watchSessionId   String? // ties response to a specific viewing
  createdAt        DateTime      @default(now())

  @@unique([videoQuestionId, studentId, watchSessionId])
  @@index([videoQuestionId])
  @@index([studentId])
  @@index([status])
}

/// In-app notifications for students (streak milestones, new exams, grade outcomes, etc.)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // streak_milestone | exam_live | grade_resolved | referral_joined
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ── Wallet ──────────────────────────────────────────────────────────────────

/// Every credit/debit against a student's balance. Immutable audit trail.
model BalanceTransaction {
  id          String   @id @default(cuid())
  userId      String
  /// credit_admin | credit_code | debit_course
  type        String
  amount      Float // positive = credit, negative = debit
  note        String? // admin note or code used
  providerRef String? // Gateway transaction reference for O(1) indexed lookup & idempotency
  adminId     String? // who credited (if type=credit_admin)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([providerRef])
}

model TeacherSubscription {
  id               String    @id @default(cuid())
  studentId        String
  teacherId        String
  planType         String    // "monthly" | "termly" | "yearly"
  planLabel        String    // e.g. "اشتراك سنوي"
  amount           Float
  educationalStage String?   // e.g. "sec_1", "sec_2"
  languageTrack    String?   @default("arabic") // "arabic" | "languages"
  studentName      String?
  studentPhone     String?
  parentPhone      String?
  paymentSource    String    @default("MANUAL") // "MANUAL" | "PAYMENT_GATEWAY" | "WALLET" | "TESTER_BYPASS"
  paymentRef       String?   // Gateway reference or transaction ID if applicable
  status           String    @default("active") // "active" | "expired" | "cancelled"
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student User @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User @relation("TeacherSubscriptions", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId, planType])
  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([paymentSource])
}

/// Superadmin-generated recharge codes students can enter to top up their balance.
model MoneyCode {
  id        String    @id @default(cuid())
  code      String    @unique
  amount    Float
  isUsed    Boolean   @default(false)
  usedById  String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([code])
  @@index([isUsed])
}

/// Superadmin-generated discount codes to modify the purchase price of specific content.
/// A DiscountCode NEVER enters the wallet and NEVER creates money.
model DiscountCode {
  id                    String              @id @default(cuid())
  code                  String              @unique
  discountType          String              // "PERCENTAGE" | "FIXED_AMOUNT"
  discountValue         Float               // e.g. 20 for 20%, or 100 for 100 EGP
  scope                 String              @default("PLATFORM_WIDE") // "PLATFORM_WIDE" | "TEACHER" | "COURSE" | "FOLDER" | "VIDEO" | "PLAN"
  targetId              String?             // Target ID matching the scope (teacherId, courseId, etc.)
  isActive              Boolean             @default(true)
  expiresAt             DateTime?
  maxTotalUses          Int?                // null = unlimited
  maxUsesPerStudent     Int                 @default(1)
  allowedPaymentMethods String?             // JSON array of string method IDs (e.g. ["wallet_balance", "vf_cash"]). null = all
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  createdBy             User                @relation("DiscountCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usages                DiscountCodeUsage[]

  @@index([code])
  @@index([scope, targetId])
  @@index([isActive])
}

/// Audit trail of each DiscountCode application during a purchase.
model DiscountCodeUsage {
  id               String       @id @default(cuid())
  discountCodeId   String
  studentId        String
  purchaseType     String       // "COURSE" | "FOLDER" | "VIDEO" | "PLAN" | "TEACHER_SUB"
  purchaseTargetId String       // ID of course, folder, video, plan, or teacher subscription key
  originalPrice    Float
  discountAmount   Float
  finalPrice       Float
  paymentMethod    String       // "wallet_balance" | "vf_cash" | "split" | etc.
  usedAt           DateTime     @default(now())

  discountCode     DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  student          User         @relation("DiscountCodeUser", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([discountCodeId])
  @@index([studentId])
  @@index([purchaseType, purchaseTargetId])
}

// ── Homework ─────────────────────────────────────────────────────────────────

/// Teacher-created homework.
/// type=link     → just an external URL to open
/// type=exam     → MCQ questions with optional image URLs per option
/// type=terminal → student pastes terminal output; whitespace-insensitive comparison + AI semantic fallback
/// type=upload   → student uploads a source file (.py, .js, .zip) to an isolated directory
model Homework {
  id               String               @id @default(cuid())
  teacherId        String
  courseId         String? // optional: link to a course
  folderId         String? // optional: link to a specific folder/محاضرة
  /// Link to a specific lesson/video this homework belongs to
  videoId          String?
  title            String
  description      String?
  type             String               @default("link") // "link" | "exam" | "terminal" | "upload"
  linkUrl          String? // for type=link
  // Terminal type fields
  expectedOutput   String? // teacher's expected output (whitespace-normalized on compare)
  codeTemplate     String? // optional starter code shown to student
  codeLanguage     String?              @default("python") // python | javascript | cpp | other
  // Upload type
  allowedFileTypes String? // comma-separated: "pdf,py,js,zip" — null = any
  dueAt            DateTime?
  isPublished      Boolean              @default(false)
  timeLimitMinutes Int                  @default(30)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  teacher          User                 @relation("TeacherHomework", fields: [teacherId], references: [id], onDelete: Cascade)
  folder           Folder?              @relation(fields: [folderId], references: [id], onDelete: Cascade)
  video            Video?               @relation(fields: [videoId], references: [id], onDelete: SetNull)
  questions        HomeworkQuestion[]
  submissions      HomeworkSubmission[]

  @@index([teacherId])
  @@index([courseId])
  @@index([folderId])
  @@index([videoId])
  @@index([isPublished])
}

model HomeworkQuestion {
  id            String   @id @default(cuid())
  homeworkId    String
  question      String
  imageUrl      String? // external URL only (Google Drive / ImgBB / etc.)
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String // "A" | "B" | "C" | "D"
  order         Int      @default(0)
  homework      Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
}

model HomeworkSubmission {
  id              String          @id @default(cuid())
  homeworkId      String
  studentId       String
  /// MCQ answers JSON: { questionId: "A"|"B"|"C"|"D" } — null for non-exam types
  answers         String? // nullable now
  score           Float?
  totalQ          Int?
  /// Submitted terminal output (for type=terminal)
  submittedOutput String?
  /// Uploaded file path (for type=upload)
  fileUrl         String?
  fileName        String?
  /// pending | passed | failed | review_requested
  status          String          @default("pending")
  completedAt     DateTime        @default(now())
  homework        Homework        @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student         User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  review          HomeworkReview?

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId])
  @@index([status])
}

/// Live Agent Review: teacher manually overrides a flagged submission verdict.
model HomeworkReview {
  id           String             @id @default(cuid())
  submissionId String             @unique
  submission   HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  teacherId    String
  /// "passed" | "failed"
  verdict      String?
  note         String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([teacherId])
}

