/// Versioned thresholds for the Teacher Command Center.
///
/// Superadmin-editable, but never edited in place: changing a threshold inserts
/// a new version and deactivates the previous one. Statuses themselves are
/// derived live from authoritative data and are deliberately NOT stored, so
/// there is no historical label to rewrite; the version exists so that anything
/// which *does* get snapshotted later (or any figure a teacher acted on) can
/// state which rules produced it.
model TeacherAlertThresholds {
  id      String  @id @default(cuid())
  version Int     @unique
  isActive Boolean @default(false)

  /// Percent of expected curriculum/plan pace below which a student is "behind".
  behindPacePercent Float @default(80)
  /// Fallback only, when no expected schedule exists: percent of the peer median.
  behindPeerPercent Float @default(50)

  /// Drop in score points, versus the student's own prior average, that counts
  /// as declining.
  decliningDropPoints Float @default(15)
  /// How many recent results form the comparison window.
  decliningWindow Int @default(3)

  /// Days without meaningful educational activity before a student is inactive.
  inactiveDays Int @default(7)

  /// Percent of incorrect attempts within one topic that counts as struggling.
  strugglingWrongPercent Float @default(40)
  /// Minimum attempts before the struggling rule is allowed to fire, so a
  /// student who answered two questions is not flagged on noise.
  strugglingMinAttempts Int @default(5)

  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([isActive])
}

// ── Security & OTP Infrastructure Models ────────────────────────────────────

/// Server-side phone OTP challenge.
///
/// The verification code is low entropy (6 digits), so its hash must never
/// reach the client — anyone holding the hash can recover the code offline in
/// well under a second. The browser only carries an opaque challenge id; the
/// keyed hash, the attempt counter and single-use consumption all live here.
model PhoneVerificationChallenge {
  id         String    @id @default(cuid())
  phone      String
  /// HMAC-SHA256(phone + code) keyed with JWT_SECRET — never leaves the server.
  codeHash   String
  method     String?
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

/// Daily WhatsApp OTP Usage Quota Manager (Hard Limit: 250/24h)
model OtpQuota {
  id                  String   @id @default(cuid())
  date                String   @unique // "YYYY-MM-DD" in Cairo Time
  limit               Int      @default(250)
  used                Int      @default(0)
  signupUsed          Int      @default(0)
  forgotPasswordUsed  Int      @default(0)
  purchaseUsed        Int      @default(0)
  phoneChangeUsed     Int      @default(0)
  codeRedemptionUsed  Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Deferred Verification Queue for OTP requests when quota is exhausted
model OtpQueueItem {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String
  actionType   String    // "PASSWORD_RESET" | "COURSE_PURCHASE" | "CODE_REDEMPTION" | "PHONE_CHANGE" | "SIGNUP"
  priority     Int       @default(5) // 1 (Highest: Reset) -> 5 (Lowest: Signup)
  status       String    @default("QUEUED") // "QUEUED" | "PROCESSING" | "SENT" | "FAILED" | "EXPIRED"
  retryCount   Int       @default(0)
  queuedAt     DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, priority, queuedAt])
  @@index([userId])
}

/// Qualified Server-Side Referral State Machine
model Referral {
  id                   String    @id @default(cuid())
  inviterId            String
  inviter              User      @relation("ReferralsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  invitedId            String    @unique // Unique constraint: Only 1 rewarded referral per student
  invited              User      @relation("ReferralReceived", fields: [invitedId], references: [id], onDelete: Cascade)
  status               String    @default("PENDING") // "PENDING" | "QUALIFIED" | "REWARDED" | "INVALID"
  qualifyingPurchaseId String?
  rewardedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([inviterId])
  @@index([status])
}

/// Log of access code redemption attempts for brute-force tracking (NEVER stores raw code)
model AccessCodeLog {
  id               String   @id @default(cuid())
  ip               String
  userId           String?
  attemptHash      String   // SHA-256 hash of attempted input
  first4Characters String   // e.g. "P9X7" for debugging
  codeLength       Int
  success          Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([ip, createdAt])
  @@index([userId, createdAt])
}

/// Centralized Security Audit Log for all sensitive platform events
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // e.g. "OTP_REQUESTED", "CODE_BLOCKED", "REFERRAL_REWARDED"
  ip        String
  device    String?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@index([ip, createdAt])
}

/// Dynamic Configuration for WhatsApp Dispatch & Parent Link Settings
model WhatsAppConfig {
  id                        String   @id @default("global")
  deliveryMode              String   @default("baileys_primary") // "baileys_only" | "official_only" | "baileys_primary" | "official_primary"
  baileysOtpTemplate        String?  // Editable template with {{studentName}}, {{otp}}, {{minutes}}, {{school}}
  autoSendParentPortal      Boolean  @default(true)
  requireParentVerification Boolean  @default(false)
  updatedAt                 DateTime @updatedAt
}

/// Outgoing WhatsApp Message Audit Log
model WhatsAppLog {
  id             String   @id @default(cuid())
  recipient      String   // E.164 phone
  provider       String   // "BAILEYS" | "OFFICIAL_API"
  messageType    String   // "OTP" | "PARENT_LINK" | "NOTIFICATION" | "ANNOUNCEMENT" | "CUSTOM"
  templateName   String?
  content        String
  status         String   // "DELIVERED" | "FAILED" | "PENDING"
  retries        Int      @default(0)
  deliveryTimeMs Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([recipient])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([messageType])
}

/// Audit Log for System WhatsApp Configuration Changes
model WhatsAppConfigLog {
  id        String   @id @default(cuid())
  adminId   String
  adminName String
  settingKey String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([settingKey, createdAt])
}

/// Daily Message Counters Resetting at Midnight
model WhatsAppDailyCounter {
  id              String   @id @default(cuid())
  date            String   // "YYYY-MM-DD"
  provider        String   // "BAILEYS" | "OFFICIAL_API"
  totalCount      Int      @default(0)
  deliveredCount  Int      @default(0)
  failedCount     Int      @default(0)
  pendingCount    Int      @default(0)
  otpCount        Int      @default(0)
  parentCount     Int      @default(0)
  authCount       Int      @default(0) // Official API auth category
  utilityCount    Int      @default(0) // Official API utility category
  marketingCount  Int      @default(0) // Official API marketing category
  updatedAt       DateTime @updatedAt

  @@unique([date, provider])
}

enum ContentType {
  VIDEO
  HOMEWORK
  QUIZ
  EXAM
  SOLUTION_VIDEO
  PDF
}

enum ContentProgressStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

enum ParentVerificationStatus {
  PENDING
  CONFIRMED
  REJECTED
  REVOKED
}

/// Cryptographically Secure 365-Day Permanent Parent Portal Token (SHA-256 Hashed)
model ParentToken {
  id                  String                   @id @default(cuid())
  studentId           String                   @unique
  student             User                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tokenHash           String                   @unique // SHA-256 hex hash of the raw URL token
  status              ParentVerificationStatus @default(PENDING)
  confirmedAt         DateTime?
  confirmedByIp       String?
  rejectedAt          DateTime?
  revokedAt           DateTime?
  parentPhoneSnapshot String?   // the exact number this link was sent to
  issueCount          Int                      @default(0)
  expiresAt           DateTime  // 365 days from creation
  sentAt              DateTime? // Timestamp when sent via WhatsApp
  accessCount         Int                      @default(0)
  lastAccessedAt      DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([status])
  @@index([tokenHash])
  @@index([studentId])
}

model ParentVerificationEvent {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  action    String   // SENT | OPENED | CONFIRMED | REJECTED | REISSUED | REVOKED_BY_ADMIN
  phone     String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

/// Parent Portal Access Audit Log
model ParentAccessLog {
  id         String   @id @default(cuid())
  studentId  String
  ip         String
  userAgent  String?
  accessedAt DateTime @default(now())

  @@index([studentId, accessedAt])
  @@index([ip])
}

/// Video Anti-Piracy Security Violation Log
model SecurityViolation {
  id        String   @id @default(cuid())
  studentId String
  videoId   String?
  type      String   // DEVTOOLS | SCREENSHOT | SCREEN_RECORD | TAB_SWITCH | CONTEXT_MENU
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([type])
  @@index([createdAt])
}

/// Direct course enrollment record (via purchase or QA tester bypass)
model CourseEnrollment {
  id                String   @id @default(cuid())
  courseId          String
  studentId         String
  fulfillmentSource String   @default("PURCHASE") // "PURCHASE" | "TESTER_BYPASS" | "ADMIN"
  amountPaid        Float    @default(0)
  createdAt         DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

/// Comprehensive QA Tester Activity Audit Trail
model TesterActivityLog {
  id          String   @id @default(cuid())
  testerId    String
  action      String   // "COURSE_ACCESS" | "VIDEO_WATCH" | "EXAM_ATTEMPT" | "AI_CONVERSATION" | "PAYMENT_BYPASS"
  targetId    String?
  targetTitle String?
  details     String?  // JSON string of action metadata
  ipAddress   String?
  createdAt   DateTime @default(now())

  tester User @relation(fields: [testerId], references: [id], onDelete: Cascade)

  @@index([testerId])
  @@index([action])
  @@index([createdAt])
}

/// Superadmin-managed VdoCipher accounts. Each account has its own API secret (AES-256-GCM encrypted),
/// player ID, 5GB bandwidth limit (configurable), and expiration date.
model VdoCipherAccount {
  id                  String                 @id @default(cuid())
  name                String                 // e.g. "Account 001"
  apiKeyEnc           String                 // AES-256-GCM ciphertext (never returned to client)
  playerId            String?                // Optional custom player theme ID
  bandwidthLimitBytes BigInt                 @default(5368709120) // 5 GB default (5 * 1024^3)
  bandwidthUsedBytes  BigInt                 @default(0)
  expiresAt           DateTime               // Account validity expiration
  isActive            Boolean                @default(true)
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  videoAssets         VdoCipherVideoAsset[]
  reservations        VdoCipherReservation[]

  @@index([isActive, expiresAt])
}

/// Tracks the instance of a video asset uploaded to a specific VdoCipher account.
model VdoCipherVideoAsset {
  id                  String                 @id @default(cuid())
  videoId             String
  accountId           String
  vdoCipherVideoId    String                 // The actual VdoCipher video ID in that account
  status              String                 @default("ready") // "pre-upload" | "uploading" | "processing" | "ready" | "error"
  durationSeconds     Int                    @default(0)
  sizeBytes           BigInt                 @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  video               Video                  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  account             VdoCipherAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([videoId, accountId])
  @@index([accountId])
  @@index([videoId])
  @@index([vdoCipherVideoId])
}

/// Secret internal viewer bandwidth reservation.
/// When a student begins watching, estimated bandwidth is reserved atomically
/// to prevent oversubscribing an account before it reaches capacity.
model VdoCipherReservation {
  id                  String                 @id @default(cuid())
  accountId           String
  videoId             String
  studentId           String
  sessionToken        String
  reservedBytes       BigInt
  status              String                 @default("active") // "active" | "completed" | "expired" | "released"
  expiresAt           DateTime
  releasedAt          DateTime?
  createdAt           DateTime               @default(now())

  account             VdoCipherAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@index([sessionToken])
  @@index([expiresAt])
}

/// Superadmin-managed Axinom Multi-DRM accounts.
/// Supports multiple pooled accounts, quota/license certificate tracking,
/// priority failover, and automatic fallback when an account expires or runs out of licenses.
model AxinomAccount {
  id                  String                 @id @default(cuid())
  name                String                 // e.g. "Axinom Main 01"
  tenantId            String                 // Axinom Tenant ID
  communicationKeyId  String                 // Axinom Communication Key ID (GUID)
  communicationKeyEnc String                 // AES-256-GCM encrypted communication key
  keySeedId           String?                // Optional Axinom Key Seed ID
  widevineLicenseUrl  String?                // Custom Widevine License Server URL (defaults to tenant URL if null)
  playreadyLicenseUrl String?                // Custom PlayReady License Server URL (defaults to tenant URL if null)
  fairplayLicenseUrl  String?                // Custom FairPlay License Server URL (defaults to tenant URL if null)
  fairplayCertUrl     String?                // Custom FairPlay Certificate URL
  licenseLimit        Int                    @default(10000) // Total certificates/licenses quota allowed
  licensesUsed        Int                    @default(0)     // Number of consumed licenses/tokens
  expiresAt           DateTime               // Account validity expiration
  isActive            Boolean                @default(true)
  isPrimary           Boolean                @default(false)
  priority            Int                    @default(1)     // 1 = top priority, 2 = fallback 1, etc.
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  licenseEvents       AxinomLicenseEvent[]

  @@index([isActive, expiresAt])
  @@index([priority])
  @@index([isPrimary])
}

/// Tracks DRM license token minting events for accurate auditing and quota tracking.
model AxinomLicenseEvent {
  id                  String                 @id @default(cuid())
  accountId           String
  videoId             String
  studentId           String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime               @default(now())

  account             AxinomAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([videoId])
}

/// Stores DRM Content Key metadata per video in DB for cross-account decryption and disaster recovery.
model AxinomVideoKey {
  id                  String                 @id @default(cuid())
  videoId             String                 @unique
  assetId             String
  keyId               String
  keyEnc              String                 // AES-256-GCM encrypted content key
  manifestUrl         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([assetId])
}

