{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next.new/types/**/*.ts",
    ".next.new/dev/types/**/*.ts",
    ".next-aitest/types/**/*.ts",
    ".next-aitest/dev/types/**/*.ts",
    ".build-essay-ai/types/**/*.ts",
    ".build-essay-ai/dev/types/**/*.ts",
    ".build-drm-s3/types/**/*.ts",
    ".build-drm-s3/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
