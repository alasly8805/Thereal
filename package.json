{
  "name": "thefake",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx tsx scripts/repair-sqlite-db.ts && next dev",
    "build": "bash scripts/deploy.sh",
    "build:raw": "node scripts/prisma-generate.js && npx next build --webpack",
    "deploy:rollback": "bash scripts/deploy.sh --rollback",
    "start": "next start",
    "prod:start": "node scripts/validate-env.mjs --production && pm2 start ecosystem.config.js",
    "prod:cluster": "npm run build && node scripts/validate-env.mjs --production && pm2 start ecosystem.config.js",
    "prod:reload": "pm2 reload ecosystem.config.js",
    "watchdog": "bash scripts/server-watchdog.sh",
    "lint": "eslint --cache",
    "audit:server": "node scripts/server-audit-tool.mjs",
    "test:verification": "node --import tsx scripts/run-verification-tests.ts",
    "test:security": "node --import tsx scripts/run-security-tests.mts",
    "test:readiness": "node --import tsx scripts/test-production-readiness.ts",
    "validate:command-center": "node --import tsx scripts/validate-command-center.mts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "node scripts/prisma-generate.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:clear": "ts-node --project tsconfig.json scripts/clearDb.ts",
    "db:backup": "node scripts/db-backup.js",
    "validate:env": "node scripts/validate-env.mjs",
    "postinstall": "node scripts/prisma-generate.js",
    "curriculum:ingest": "python scripts/curriculum/ingest.py",
    "curriculum:embed": "node scripts/curriculum/embed.mjs",
    "curriculum:test": "npx tsx scripts/curriculum/test-retrieval.ts",
    "curriculum:build": "npm run curriculum:ingest && npm run curriculum:embed && npm run curriculum:test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-sns": "^3.1090.0",
    "@aws-sdk/cloudfront-signer": "^3.1125.0",
    "@aws-sdk/lib-storage": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "@smithy/credential-provider-imds": "^4.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@whiskeysockets/baileys": "^6.7.18",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "confbox": "^0.2.4",
    "firebase": "^12.14.0",
    "framer-motion": "^12.43.0",
    "hls.js": "^1.7.3",
    "jimp": "^1.6.0",
    "jose": "^6.2.3",
    "libsql": "^0.5.29",
    "lightningcss": "^1.32.0",
    "lucide-react": "^1.17.0",
    "motion-dom": "^12.40.0",
    "next": "^16.3.4",
    "node-cron": "^4.5.0",
    "pg": "^8.10.0",
    "pino": "^9.6.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.8",
    "ts-morph": "^28.0.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.1",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
