# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
*.db
*.db-journal
/dev.db
/dev.db-journal
prisma/*.db
prisma/*.db-journal
prisma/backups/

# WhatsApp Baileys Auth & Logs
whatsapp-auth/
logs/


# Python bytecode from the curriculum ingestion scripts
__pycache__/
*.pyc

# Local video uploads & encrypted DRM assets
uploads/
bin/

.env.save
.env.save.1
.env.save.2
.eslintcache
scratch/

# watchdog build-recovery working dirs (see scripts/server-watchdog.sh).
# .next.last-good is the verified snapshot the self-heal restores from; the
# others are transient staging dirs used during a snapshot/restore swap.
/.next.last-good/
/.next.last-good.tmp/
/.next.last-good.old/
/.next.restoring/
/.next.broken/
