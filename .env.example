# =============================================================================
# Code-UP — environment variables
# Copy to `.env` or `.env.local` and replace placeholder values.
# Next.js loads: .env.local (overrides) > .env
# =========================================================================
# --- Required: database ---
# Local dev (recommended): SQLite file
DATABASE_URL="file:./dev.db"
# Production Supabase: PostgreSQL (switch prisma/schema.prisma provider to postgresql)
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# --- Required: JWT auth ---
# Use at least 32 random characters. Generate: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-secret-min-32-chars"

# --- Required: Twilio SMS verification (student phone verification) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-your-auth-token"
TWILIO_FROM_NUMBER="+201XXXXXXXXX"

# Set to "true" to bypass Twilio during local development or demos.
# When enabled, the app will treat phone verification as approved without calling Twilio.
TWILIO_BYPASS_VERIFICATION="false"

# --- Recommended: app URLs ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin panel ---
SUPERADMIN_MASTER_PASSWORD="change-me"

# --- Payment WhatsApp number ---
# WhatsApp number for students to contact for paid course purchases
NEXT_PUBLIC_PAYMENT_ACCESS_PASSWORD="+201118802621"

# Action passwords — validated server-side for destructive operations.
# NEVER exposed to the browser.  Generate: openssl rand -base64 24
#
# SUPERADMIN — full access (suspend/delete students, edit/delete teachers)
SUPERADMIN_ACTION_PASSWORD="replace-with-strong-random-password"
# ADMIN — limited access (suspend/soft-delete students, reset teacher password)
ADMIN_ACTION_PASSWORD="replace-with-admin-password"
# STAFF — read-only, no action password needed
# STAFF_ACCESS_PASSWORD is reserved for future login gating if required

# SUPPORT PANEL — gates /thefake/support (grant extra views, unlock content past
# a prerequisite, enter a student account read-only, reset student passwords,
# create discount codes up to 10%). Rotatable here without a redeploy.
# SUPERADMIN_MASTER_PASSWORD also works as break-glass.
# Quote the value. dotenv treats an unquoted '#' as the start of an inline
# comment, so an unquoted password containing '#' is silently truncated there.
SUPPORT_PANEL_PASSWORD="replace-with-strong-random-password"

# --- Native Video SaaS (Alasly — Super Native DRM) ---
VIDEO_API_KEY=""
VIDEO_API_SECRET=""
VIDEO_WEBHOOK_SECRET=""
VIDEO_API_BASE_URL="https://rkmsjkcnpmqpiugcsvld.supabase.co/functions/v1/video-service/v1"
# Legacy aliases (supported for backward compatibility):
# ALASLY_API_KEY=""
# ALASLY_API_SECRET=""
# ALASLY_WEBHOOK_SECRET=""
# ALASLY_BASE_URL=""

# --- VdoCipher DRM Video (optional) ---
VDOCIPHER_API_SECRET=""

# --- Bunny Stream / CDN (optional — video playback) ---
BUNNY_LIBRARY_ID="650875"
BUNNY_API_KEY=""
BUNNY_TOKEN_KEY=""
BUNNY_CDN_HOSTNAME="vz-a3ef6e25-703.b-cdn.net"
# Aliases used by secure-url API:
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_TOKEN_AUTH_KEY=""
# "true" only when Bunny library has Embed View Token Authentication enabled
BUNNY_EMBED_SIGNING_ENABLED="false"
NEXT_PUBLIC_BUNNY_LIBRARY_ID="666960"

# --- AI study assistant (optional) ---
# Primary: Claude (Anthropic)
# Backup: Gemini (Google)
AI_PRIMARY_API_KEY="" # Your Claude API key
AI_PRIMARY_BASE_URL="https://api.anthropic.com/v1/messages"
AI_PRIMARY_MODEL="claude-3-5-sonnet-20241022"
AI_BACKUP_API_KEY="" # Your Gemini API key (optional fallback)
AI_BACKUP_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_BACKUP_MODEL="gemini-2.0-flash"

# WhatsApp Business API Config
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_PERMANENT_TOKEN=""
WHATSAPP_OTP_TEMPLATE_NAME="codeup_otp_login"
WHATSAPP_OTP_TEMPLATE_LANG="ar"

# --- reCAPTCHA Enterprise (bot protection on login & signup) ---
# Public site key — safe to expose in browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-enterprise-site-key"
# Server-only: Google Cloud API key (reCAPTCHA Enterprise API must be enabled)
# Create at: https://console.cloud.google.com/apis/credentials
RECAPTCHA_API_KEY="your-google-cloud-api-key"
# Set to "true" to skip reCAPTCHA checks during local development
RECAPTCHA_BYPASS="false"

# --- Sha7nawy Payment Gateway ---
SHA7NAWY_BASE_URL="https://gate.sha7nawy.com"
SHA7NAWY_PUBLIC_KEY="your-sha7nawy-public-key"
SHA7NAWY_SECRET_KEY="your-sha7nawy-secret-key"
# REQUIRED IN PRODUCTION. Shared secret sent by the gateway as the
# x-webhook-secret header. Without it the webhook returns 500 for every delivery
# and wallet top-ups are never credited automatically.
SHA7NAWY_WEBHOOK_SECRET=""

# --- Shake-Out Payment Gateway (Fawry Pay) ---
SHAKEOUT_BASE_URL="https://dash.shake-out.com"
SHAKEOUT_PUBLIC_KEY="your-shakeout-public-key"
# REQUIRED IN PRODUCTION — same role as SHA7NAWY_WEBHOOK_SECRET above.
SHAKEOUT_WEBHOOK_SECRET=""

# --- Scheduled jobs ---
# REQUIRED IN PRODUCTION. Bearer token for /api/cron/*. There is deliberately no
# default: a previous build shipped the literal "codeup_secret_cron" in source,
# which let anyone drain the WhatsApp OTP queue. Generate: openssl rand -base64 24
CRON_SECRET=""

# --- OTP delivery ---
# At least ONE channel must be configured in production, or signup and password
# reset both fail: sendVerificationCode() tries the WhatsApp Cloud API first and
# falls back to AWS SNS, and throws if neither is available.
#   Channel 1 — WhatsApp Cloud API: WHATSAPP_PHONE_NUMBER_ID + WHATSAPP_PERMANENT_TOKEN (above)
#   Channel 2 — AWS SNS SMS:
AWS_REGION="eu-north-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Set to "true" instead of keys when running on an EC2/ECS instance role.
AWS_USE_INSTANCE_ROLE="false"

# Secure defaults to ON in production. Set to "false" ONLY for a deployment that
# genuinely terminates on plain HTTP.
# SECURE_COOKIES="true"

# --- Google Drive Service Account Downloader ---
# Used by teachers to download and import videos from Google Drive into Native Security.
# Private files must be shared with the Service Account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PROJECT_ID="your-project-id"


# --- Axinom Multi-DRM (Widevine / PlayReady / FairPlay) ---
# Required. Tokens are signed with this key; a missing value now throws rather
# than minting a token Axinom will reject with an opaque error.
AXINOM_COMMUNICATION_KEY=
AXINOM_COMMUNICATION_KEY_ID=
AXINOM_TENANT_ID=
AXINOM_KEY_SEED_ID=
AXINOM_WIDEVINE_LICENSE_URL=
AXINOM_PLAYREADY_LICENSE_URL=
AXINOM_FAIRPLAY_LICENSE_URL=
AXINOM_FAIRPLAY_CERT_URL=

# Gates the restricted DRM upload options in the teacher panel. Verified
# server-side on both the gate route and the video-create route; if unset, DRM
# uploads are refused (fail closed) rather than allowed.
DRM_UPLOAD_PASSWORD=

# Leave UNSET for tiered DRM (recommended): renditions are split across two
# content keys, so hardware devices (Widevine L1 / PlayReady SL3000) receive the
# HD key while software devices (L3 / SL2000) get SD only. Everyone can watch,
# and anything captured on a software CDM is low resolution.
#
# Set to "true" only for hardware-or-nothing: playback is refused outright
# without a hardware-backed CDM. Strictest, but blocks most desktop Chrome.
NEXT_PUBLIC_DRM_REQUIRE_HARDWARE=

# --- CloudFront signed URLs for lesson videos (optional; without these the server proxies S3/local) ---
CLOUDFRONT_VIDEO_DOMAIN=""
CLOUDFRONT_KEY_PAIR_ID=""
CLOUDFRONT_PRIVATE_KEY=""
# AWS_S3_STORAGE_BUCKET="codeup-storage-687374520011"
# VIDEO_S3_DISABLED="false"
